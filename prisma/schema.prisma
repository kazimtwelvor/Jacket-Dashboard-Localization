model Billboard {
  id         String     @id @default(cuid())
  storeId    String
  store      Store      @relation("StoreToBillboard", fields: [storeId], references: [id])
  label      String
  imageUrl   String
  categories Category[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([storeId])
}

model Category {
  id          String     @id @default(cuid())
  storeId     String
  store       Store      @relation("StoreToCategory", fields: [storeId], references: [id])
  billboardId String?
  slug        String     @unique
  billboard   Billboard? @relation(fields: [billboardId], references: [id])
  name        String
  imageUrl    String?
  type        String? // Kept the type field for category types (material, style, gender)
  isBest      Boolean?   @default(false)
  categoryContent Json? // Template content for category page
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([storeId])
  @@index([billboardId])
}

model Product {
  id            String         @id @default(cuid())
  storeId       String
  store         Store          @relation("StoreToProduct", fields: [storeId], references: [id])
  categoryData  Json?          // Stores {material: string, style: string, gender: string}
  name          String
  price         Decimal
  isFeatured    Boolean        @default(false)
  isBest        Boolean        @default(false) 
  isArchived    Boolean        @default(false)
  sizeDetails   Json?        
  colorDetails  Json?          
  baseColor     Json?        
  images        ProductImage[]
  orderItems    OrderItem[]
  isDiscounted  Boolean        @default(false)
  isPublished   Boolean        @default(true)
  isDeleted     Boolean        @default(false)
  deletedAt     DateTime?
  reviews       Review[]

  sku            String   @unique
  stockStatus    String?  @default("instock") // instock, outofstock, onbackorder
  description    String?  @db.Text
  salePrice      Decimal?
  specifications Json?   
  tags           String[]
  gender         String?
  colorLinks     Json?
  relatedProducts String[] @default([]) // Array of product IDs

  metaTitle          String?
  metaDescription    String?  @db.Text
  slug               String?
  keywords           String[]
  brandName          String?
  schema             String?  @db.Text  // Add this field to store JSON-LD schema data

  isParentProduct Boolean? @default(false)
  parentProductId String? // Reference to parent product

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById    String?
  createdByName  String?
  createdByEmail String?
  updatedById    String?
  updatedByName  String?
  updatedByEmail String?

  @@index([storeId])
  @@index([slug])
  @@index([sku])
}


model Size {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation("StoreToSize", fields: [storeId], references: [id])
  name         String
  value        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([storeId])
}

model Color {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation("StoreToColor", fields: [storeId], references: [id])
  name      String
  value     String
  value2    String?   // Optional second color
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([storeId])
}

model Image {
  id          String         @id @default(cuid())
  url         String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  altText     String?       @db.VarChar(255)
  title       String?       @db.VarChar(255)
  caption     String?       @db.VarChar(255)
  description String?       @db.Text
  excludeFromSitemap Boolean @default(false)
  products    ProductImage[]

  @@index([url])
}
// New join table for many-to-many relationship
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageId   String
  image     Image    @relation(fields: [imageId], references: [id], onDelete: Cascade)
  order     Int      @default(0) // For maintaining image order in product gallery
  isPrimary Boolean  @default(false) // To mark the primary/featured image
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, imageId])
  @@index([productId])
  @@index([imageId])
}

model Page {
  id           String         @id @default(cuid())
  storeId      String
  store        Store          @relation("StoreToPage", fields: [storeId], references: [id], onDelete: Cascade)
  title        String
  slug         String
  description  String?        @db.Text
  content      String?        @db.Text
  thumbnail    String? // URL to page thumbnail
  pageType     PageType       @default(CUSTOM)
  status       PageStatus     @default(DRAFT)
  isHomepage   Boolean        @default(false)
  seo          Json? // SEO metadata
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  isPublished  Boolean        @default(false)
  publishedAt  DateTime?
  authorId     String? // Optional link to user who created it
  categories   PageCategory[]
  templateId   String? // Reference to the template this page is based on
  templateName String? // Changed from templateId with foreign key
  template     Template?      @relation(fields: [templateId], references: [id])

  @@unique([storeId, slug])
  @@index([storeId, pageType])
  @@index([storeId, status])
  @@index([templateId])
}

model PageCategory {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  pages     Page[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, slug])
}

model PageTemplate {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  description String?  @db.Text
  thumbnail   String? // URL to template thumbnail
  content     Json // Stores the serialized Craft.js JSON
  category    String? // Template category (blog, landing page, etc.)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([storeId, category])
}

model PageRevision {
  id        String   @id @default(cuid())
  pageId    String
  content   Json // Stores the serialized Craft.js JSON
  createdAt DateTime @default(now())
  createdBy String? // User who made this revision
  comment   String? // Optional revision comment
}

// New Template model for the template-based page system
model Template {
  id          String   @id @default(uuid())
  storeId     String
  store       Store    @relation("StoreToTemplate", fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  description String?  @db.Text
  thumbnail   String? // URL to template thumbnail
  content     Json // Stores the template structure
  category    String? // Template category (blog, landing page, etc.)
  isDefault   Boolean  @default(false)
  isSystem    Boolean  @default(false) // Indicates if this is a system template
  pages       Page[] // Pages based on this template
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([storeId])
  @@index([category])
}

enum PageType {
  BLOG
  LANDING
  ABOUT
  CONTACT
  CUSTOM
  PRODUCT_LISTING
}

enum PageStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

model Order {
  id                 String      @id @default(cuid())
  storeId            String
  store              Store       @relation("StoreToOrder", fields: [storeId], references: [id])
  userId             String?
  user               StoreUser?  @relation("UserToOrder", fields: [userId], references: [id], onDelete: SetNull)
  orderItems         OrderItem[]
  isPaid             Boolean     @default(false)
  phone              String      @default("")
  address            String      @default("")
  status             OrderStatus @default(PENDING)
  paymentMethod      String?
  shippingMethod     String?
  shippingCost       Decimal?    @default(0)
// tax                Decimal?    @default(0)
  discount           Decimal?    @default(0)
  total              Decimal?
  notes              String?     @db.Text
// trackingNumber     String?
  
  customerName       String?
  customerEmail      String?
  billingAddress     String?     @db.Text
  shippingAddress    String?     @db.Text
  city               String?
  country            String?
  state              String?
  zipCode            String?
  
 // fulfillmentStatus  String?     @default("pending") // pending, processing, shipped, delivered
 // estimatedDelivery  DateTime?
 // actualDelivery     DateTime?
  
  transactionId      String?
  paymentStatus      String?     @default("pending") // pending, completed, failed, refunded
  
//  cardNumber         String?
//  expirationDate     String?     // MM/YY format
//  securityCode       String?     // CVC
//  cardCountry        String?
  
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([storeId])
  @@index([status])
  @@index([userId])
  @@index([transactionId])
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id])
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  quantity        Int      @default(1)
  customerName    String   @default("Customer")
  
  // Price tracking
  price           Decimal
  originalPrice   Decimal?
  discountAmount  Decimal? @default(0)
  total           Decimal?
  
  // Product configuration
  sizeIds         String[]
  colorIds        String[]
  selectedOptions Json?    // For storing additional product option selections
  
  // Product metadata at time of order
  productSku      String?
  productName     String?
  
  // Review status
  hasBeenReviewed Boolean  @default(false)
  
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([productSku])
}




model Review {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation("StoreToReview", fields: [storeId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  userId     String
  userName   String
  email      String?  // Added email field for storing customer email
  rating     Int
  title      String?
  comment    String   @db.Text
  isApproved Boolean  @default(false)
  photoUrl   String?  // Added photoUrl field for storing review images
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([storeId])
  @@index([productId])
  @@index([userId])
  @@index([email])
}
// Add these models to your existing schema.prisma file

model ExportLog {
  id           String   @id @default(uuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  fileName     String
  fileType     String
  productCount Int
  status       String   // "processing", "completed", "failed"
  fileUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([storeId])
}

model ImportLog {
  id           String   @id @default(uuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  fileName     String
  fileType     String
  totalRows    Int
  successCount Int
  errorCount   Int
  status       String   // "processing", "completed", "completed_with_errors", "failed"
  errorLogUrl  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([storeId])
}

model RecaptchaSettings {
  id                String   @id @default(cuid())
  storeId           String   @unique
  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  siteKey           String
  secretKey         String
  enabled           Boolean  @default(false)
  version           String   @default("v3") // "v2" or "v3"
  threshold         Float?   @default(0.5)  // For v3 only, score threshold
  enabledOnLogin    Boolean  @default(true)
  enabledOnRegister Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([storeId])
}

model Blog {
  id            String    @id @default(uuid())
  storeId       String
  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  slug          String?
  title         String?
  isPublished   Boolean   @default(false)
  content       Json      // Stores all blog content as JSON including sections and their fields
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([storeId])
}

model CategoryPage {
  id              String    @id @default(uuid())
  storeId         String
  store           Store     @relation("StoreToCategoryPage", fields: [storeId], references: [id], onDelete: Cascade)
  name            String
  slug            String
  apiSlug         String?   // Query string for filtering products
  description     String?   @db.Text
  imageUrl        String?   // Image URL for the category page
  bannerImageUrl  String?   // Banner image URL for the category page
  materials       String[]  // Array of material names
  styles          String[]  // Array of style names
  colors          String[]  // Array of color names
  genders         String[]  // Array of gender names
  collars         String[]  // Array of collar types
  cuffs           String[]  // Array of cuff types
  closures        String[]  // Array of closure types
  pockets         String[]  // Array of pocket types
  isBest          Boolean?  @default(false)
  seoTitle        String?
  seoDescription  String?   @db.Text
  focusKeyword     String?   // Primary focus keyword
  supportingKeywords String[]  // Array of supporting keywords
  categoryContent Json?     // Stores the editable category template content as JSON
  // Additional SEO fields from product form
  ogTitle         String?
  ogDescription   String?   @db.Text
  twitterTitle    String?
  twitterDescription String? @db.Text
  canonicalUrl    String?
  indexPage       Boolean   @default(true)
  followLinks     Boolean   @default(true)
  // Schema fields
  enableSchema    Boolean   @default(true)
  schemaType      String?   @default("CollectionPage")
  customSchema    String?   @db.Text
  status          CategoryPageStatus @default(DRAFT)
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
}

enum CategoryPageStatus {
  DRAFT
  PUBLISHED
}

model ContactForm {
  id                    String            @id @default(cuid())
  storeId               String
  store                 Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  firstName             String
  lastName              String
  email                 String
  subject               String
  message               String            @db.Text
  agreeToPrivacyPolicy  Boolean           @default(false)
  status                ContactFormStatus @default(PENDING)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([storeId])
  @@index([email])
}

enum ContactFormStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model NewsletterForm {
  id        String              @id @default(cuid())
  storeId   String
  store     Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  email     String
  status    NewsletterFormStatus @default(ACTIVE)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([storeId])
  @@index([email])
}

enum NewsletterFormStatus {
  ACTIVE
  INACTIVE
  UNSUBSCRIBED
}

model Voucher {
  id              String      @id @default(cuid())
  storeId         String
  store           Store       @relation("StoreToVoucher", fields: [storeId], references: [id], onDelete: Cascade)
  code            String      @unique
  type            VoucherType
  value           Decimal     // Percentage or fixed amount
  minOrderAmount  Decimal?    // Minimum order amount to use voucher
  maxDiscount     Decimal?    // Maximum discount for percentage vouchers
  usageLimit      Int?        // Maximum number of uses
  usedCount       Int         @default(0)
  isActive        Boolean     @default(true)
  validFrom       DateTime    @default(now())
  validUntil      DateTime?
  description     String?     @db.Text
  // For "Buy X Get Y" type vouchers
  buyQuantity     Int?        // Buy X products
  getQuantity     Int?        // Get Y products free
  applicableProducts String[] @default([]) // Product IDs this voucher applies to
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([storeId])
  @@index([code])
}

enum VoucherType {
  PERCENTAGE  // FJ-30% - percentage discount
  FIXED       // FJ-100 - fixed amount discount
  BUY_X_GET_Y // Buy 2 get 1 free
}
