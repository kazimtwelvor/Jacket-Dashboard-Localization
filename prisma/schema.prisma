// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id                  String      @id @default(uuid())
  name                String
  userId              String
  url                 String
  skuPrefix           String?
  billboards          Billboard[] @relation("StoreToBillboard")
  categories          Category[]  @relation("StoreToCategory")
  products            Product[]   @relation("StoreToProduct")
  sizes               Size[]      @relation("StoreToSize")
  colors              Color[]     @relation("StoreToColor")
  orders              Order[]     @relation("StoreToOrder")
  reviews             Review[]    @relation("StoreToReview")
  storeUsers          StoreUser[] @relation("StoreToStoreUser")
  
  pages               Page[]      @relation("StoreToPage")
  pageCategories      PageCategory[]
  pageTemplates       PageTemplate[]
  templates           Template[]   @relation("StoreToTemplate")
  invitations         Invitation[] @relation("StoreToInvitation")
  members             Member[]     @relation("StoreToMember")
  stripeAccounts      StripeAccount[] @relation("StoreToStripeAccount")
  recaptchaSettings   RecaptchaSettings?
  blogs               Blog[]
  categoryPages       CategoryPage[] @relation("StoreToCategoryPage")
  contactForms        ContactForm[]
  newsletterForms     NewsletterForm[]
  vouchers            Voucher[]   @relation("StoreToVoucher")
  // Payment fields
  paypalClientId      String?   @default("")
  paypalClientSecret  String?   @default("")
  paypalEnabled       Boolean   @default(false)
  paypalSandboxMode   Boolean   @default(true)
  stripePublishableKey String?   @default("")
  stripeSecretKey     String?   @default("")
  stripeEnabled       Boolean   @default(false)
  stripeTestMode      Boolean   @default(true)
  cashOnDeliveryEnabled Boolean  @default(false)
  cashOnDeliveryFee   Int       @default(0)
  bankTransferEnabled Boolean   @default(false)
  bankTransferDetails String?   @default("")
  stripeWebhookSecret String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  exportLogs ExportLog[]
  importLogs ImportLog[]
}

model StripeAccount {
  id                String   @id @default(cuid())
  storeId           String
  store             Store    @relation("StoreToStripeAccount", fields: [storeId], references: [id], onDelete: Cascade)
  name              String   // Account name/label
  publishableKey    String
  secretKey         String
  webhookSecret     String?
  isEnabled         Boolean  @default(false)
  isTestMode        Boolean  @default(true)
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([storeId])
}

model Invitation {
  id          String           @id @default(cuid())
  storeId     String
  store       Store            @relation("StoreToInvitation", fields: [storeId], references: [id], onDelete: Cascade)
  email       String?
  role        StoreRole        @default(VIEWER)
  token       String           @unique
  expires     DateTime
  status      InvitationStatus @default(PENDING)
  permissions Permission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([storeId, email])
  @@index([storeId])
  @@index([token])
  @@index([email])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

// New User Models
model User {
  id                String         @id @default(cuid())
  name              String
  email             String?         @unique
  emailVerified     DateTime?
  password          String?
  passwordHash      String?         
  role              AdminUserRole       @default(CUSTOMER)
  
  isActive          Boolean        @default(true)
  isBanned          Boolean        @default(false)
  lastLogin         DateTime?
  twoFactorEnabled  Boolean        @default(false)
  twoFactorSecret   String?
  resetToken        String?
  resetTokenExpiry  DateTime?
  verificationToken String?
  verifyToken       String?        // Added from new schema
  resetTokenExp     DateTime?      // Added from new schema

  isVerified        Boolean       @default(false) // Added from new schema
  storeUsers        StoreUser[]
  sessions          Session[]
  auditLogs         AuditLog[]
  members           Member[]       // Added from new schema
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Add Clerk userId field for integration with Clerk
  clerkId String? @unique
}

enum AdminUserRole {
  SUPER_ADMIN
  ADMIN
  USER
  STORE_ADMIN
  STORE_MANAGER
  CONTENT_EDITOR
  CUSTOMER_SERVICE
  CUSTOMER
}


model StoreUser {
  id             String   @id @default(cuid())
  email          String?  @unique  
  name           String?
  passwordHash   String?
  store          Store    @relation("StoreToStoreUser", fields: [storeId], references: [id], onDelete: Cascade)
  storeId        String
  role           StoreRole? @default(VIEWER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  phone          String?
  address        String?
  permissions    String[]
  isOwner        Boolean      @default(false) // Added to identify the store owner
  city           String?
  state          String?
  zipCode        String?
  country        String?
  isVerified     Boolean  @default(false)
  verifyToken    String?
  resetToken     String?
  resetTokenExp  DateTime?
  lastLogin      DateTime?
  orders         Order[]  @relation("UserToOrder")
  
  @@index([storeId])
}

enum StoreRole {
  OWNER
  ADMIN
  MANAGER
  EDITOR
  SUPPORT
  VIEWER
}

enum Permission {
  MANAGE_STORE
  MANAGE_PRODUCTS
  MANAGE_ORDERS
  MANAGE_CUSTOMERS
  MANAGE_STAFF
  MANAGE_SETTINGS
  MANAGE_MARKETING
  VIEW_ANALYTICS
  PROCESS_REFUNDS
  MANAGE_REVIEWS
}

model Member {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation("StoreToMember", fields: [storeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member") // owner, admin, member
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, userId])
  @@index([storeId])
}


model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  ipAddress    String?
  userAgent    String?
  lastActivity DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
}

